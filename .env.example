# ==============================================================================
# mone Agent — Environment Configuration (.env)
# Non-Custodial Bring-Your-Own-Key (BYOK) Quantitative Trading Agent
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Neatlogs Observability (Mandatory for Hackathon Telemetry)
# ------------------------------------------------------------------------------
NEATLOGS_API_KEY=CWkvQ30hGStyqjsjlxMo0LM-h9pQ9oAR
NEATLOGS_WORKFLOW_NAME=mone-trading-agent
NEATLOGS_TRACING_ENABLED=true

# ------------------------------------------------------------------------------
# 2. Weather Provider Configuration
# Supported providers: "auto", "weathernext3", "openmeteo"
# - "auto": Tries WeatherNext 3 BigQuery/GCS first; falls back to Open-Meteo WeatherNext 2 on failure
# - "openmeteo": Free, 63-member WeatherNext 2 ensemble via Open-Meteo REST API (zero-auth)
# - "weathernext3": Google DeepMind WeatherNext 3 via BigQuery / GCS Zarr v3
# ------------------------------------------------------------------------------
WEATHER_PROVIDER=auto

# WeatherNext 3 BigQuery Settings (Required only if WEATHER_PROVIDER=weathernext3 or auto with GCP)
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=
WEATHERNEXT3_BQ_TABLE=weathernext_3_0_0_0p05deg
WEATHERNEXT3_GCS_BUCKET=weathernext3_spatial

# Open-Meteo Settings (Fallback / Zero-Auth default)
OPENMETEO_API_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPENMETEO_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 3. Market Venues & Credentials
# Supported venues: "kalshi_demo", "kalshi_live", "polymarket", "paper"
# ------------------------------------------------------------------------------
DEFAULT_VENUE=paper

# Kalshi Demo (api v2 demo)
KALSHI_DEMO_EMAIL=
KALSHI_DEMO_PASSWORD=
KALSHI_DEMO_API_KEY_ID=
KALSHI_DEMO_PRIVATE_KEY_PATH=

# Kalshi Live Production (api v2 production)
KALSHI_EMAIL=
KALSHI_PASSWORD=
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Polymarket (Polygon Web3)
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=
POLYMARKET_PROXY_WALLET=

# ------------------------------------------------------------------------------
# 4. Quantitative Strategy & Risk Guardrails
# ------------------------------------------------------------------------------
# Threshold probability to trigger Long YES position (%)
LONG_YES_PROB_THRESHOLD=75.0

# Threshold probability to trigger Long NO position (%)
LONG_NO_PROB_THRESHOLD=25.0

# Maximum ask price permitted to execute a trade (cents: 80c = $0.80)
MAX_ENTRY_ASK_PRICE=0.80

# Capital allocated per individual position ($ USD)
CAPITAL_PER_TRADE=10.00

# Daily stop-loss circuit breaker ($ USD cumulative loss before halts)
MAX_DAILY_DRAWDOWN=50.00

# Minimum edge over market price required to place an order (e.g. 0.05 = 5%)
MIN_EDGE_THRESHOLD=0.05

# Rain threshold in millimeters (0.25 mm = 0.01 inches for NWS KXRAIN)
RAIN_THRESHOLD_MM=0.25

# ------------------------------------------------------------------------------
# 5. Agent Autonomy & Execution Mode
# "autonomous": Full automated execution within risk guardrails
# "copilot": Signals are staged in SQLite for 1-click manual confirmation
# ------------------------------------------------------------------------------
AGENT_AUTONOMY_MODE=copilot

# Polling / Execution Interval (in minutes, e.g. 60 = hourly)
EXECUTION_INTERVAL_MINUTES=60

# Database Storage Path (SQLite zero-config ledger)
DATABASE_URL=sqlite:///./mone.db

# ------------------------------------------------------------------------------
# 6. Dodo Payments (Runner Compute Fuel & SaaS Pro Subscriptions)
# ------------------------------------------------------------------------------
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
DODO_PAYMENTS_ENVIRONMENT=test
